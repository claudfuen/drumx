          "hand": "L",
          "accent": false
        }
      ],
      "focus": "Steady quarter notes",
      "durationSeconds": 60
    },
    {
      "id": "single-strokes",
      "title": "Single strokes",
      "subtitle": "Build an even conversation.",
      "category": "Rudiments",
      "level": "02",
      "description": "Alternate R L on the snare, with two strokes per click. Count 1 & 2 & 3 & 4 &. This is the single-stroke roll sticking at an even practice tempo.",
      "coachTip": "Match the sound of both hands. The R and L labels guide your sticking; a normal snare MIDI note cannot verify the hand.",
      "bpm": 65,
      "targetBpm": 100,
