    {
      "id": "find-the-pulse",
      "title": "Find the pulse",
      "subtitle": "One beat. One stroke.",
      "category": "Foundations",
      "level": "01",
      "description": "Play one snare stroke on every click. Count 1, 2, 3, 4 aloud and alternate your hands. Aim for equal spaces between notes.",
      "coachTip": "Keep your grip light and let the stick rebound. Listen for your stroke and the click to sound together.",
      "bpm": 60,
      "targetBpm": 90,
      "subdivision": 1,
      "steps": [
        {
          "voices": [
            "snare"
          ],
          "hand": "R",
          "accent": false
        },
        {
          "voices": [
            "snare"
          ],
          "hand": "L",
          "accent": false
        },
        {
          "voices": [
            "snare"
