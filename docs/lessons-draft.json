    {
      "id": "first-groove",
      "title": "Your first groove",
      "subtitle": "Bring your feet into the music.",
      "category": "Coordination",
      "level": "06",
      "description": "Play eighth notes on the closed hi-hat, kick on beats 1 and 3, and snare on 2 and 4. Notes in the same column happen together.",
      "coachTip": "Use your right hand on hi-hat, left on snare and bass-drum foot on kick, or mirror this setup. Keep the hi-hat steady as the other limbs join.",
      "bpm": 60,
      "targetBpm": 100,
      "subdivision": 2,
      "steps": [
        {
          "voices": [
            "hihat",
            "kick"
          ]
        },
