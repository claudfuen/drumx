    {
      "id": "accent-control",
      "title": "Accent control",
      "subtitle": "Give the pulse a voice.",
      "category": "Foundations",
      "level": "05",
      "description": "Alternate sixteenth notes on the snare. Emphasize the first note of each beat and play the other three softly. Keep the rhythm unchanged.",
      "coachTip": "Use a little more stick height for accents. Listen for a clear loud-soft contrast; the timing score alone cannot assess your dynamics or technique.",
