    {
      "id": "kick-on-the-and",
      "title": "Kick on the &",
      "subtitle": "A small change. A new feel.",
      "category": "Coordination",
      "level": "07",
      "description": "Keep the eighth-note hi-hat and snare on 2 and 4. Play kick on 1, 3, and the & of 3. The extra kick lands halfway between beats 3 and 4.",
      "coachTip": "Count every & aloud. Keep your hands on their original pattern when the extra bass-drum note arrives.",
      "bpm": 60,
      "targetBpm": 95,
      "subdivision": 2,
      "steps": [
