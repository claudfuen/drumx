[configuration]
entry_symbol = "drumx_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
macos.debug = "res://bin/drumx_engine.dylib"
macos.release = "res://bin/drumx_engine.dylib"
windows.debug.x86_64 = "res://bin/drumx_engine.dll"
windows.release.x86_64 = "res://bin/drumx_engine.dll"
